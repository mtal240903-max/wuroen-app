model BusinessPlan {
  id              String         @id @default(uuid())
  workspaceId     String         // Lié à la page Wuro'en
  companyId       String?        // Optionnel : Si rattaché à une entreprise mère
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  isDirectProject Boolean        @default(true) // True = Projet direct, False = Projet d'entreprise
  title           String
  sector          SectorType     // AGRICULTURE, ELEVAGE, COMMERCE, SERVICES, etc.
  currency        String         @default("XOF")
  durationYears   Int            @default(5)
  discountRate    Float          // Taux d'actualisation pour VAN/TRI
  
  promoter        Promoter?
  project         ProjectInfo?
  investments     Investment[]
  products        Product[]
  variableCosts   VariableCost[]
  fixedCosts      FixedCost[]
  salaries        Salary[]
  financing       Financing[]
  bfrParams       BfrParam?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Company {
  id            String         @id @default(uuid())
  workspaceId   String
  name          String
  budget        Float          // Budget global ou trésorerie de l'entreprise mère
  businessPlans BusinessPlan[] // Projets et plans d'affaires rattachés
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}